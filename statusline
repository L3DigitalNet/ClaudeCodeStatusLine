    "format_reset_time_with_day",
    "format_tokens",
    "get_ctx_color",
    "get_git_branch",
    "get_quota_rate_color",
    "main",
    "parse_payload",
    "render_statusline",
    "write_text_atomic",
]

CtxColor = Literal["green", "yellow", "orange3", "red"]
QuotaColor = Literal["green", "yellow", "red"]


